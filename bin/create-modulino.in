#!/usr/bin/env bash
#-*- mode: sh; -*-
# modulino invocation

MODULINO_WRAPPER=create-modulino
MODULE_NAME=CLI::Simple::Modulino
MODULE_PATH=$(MODULE_PATH="${MODULE_NAME//:://}.pm" perl -M$MODULE_NAME -e 'print $INC{$ENV{MODULE_PATH}};')

if [ "$*" = "" ]; then
    MODULINO_WRAPPER=$MODULINO_WRAPPER perl $MODULE_PATH -h
else
    MODULINO_WRAPPER=$MODULINO_WRAPPER perl $MODULE_PATH "$@"
fi
